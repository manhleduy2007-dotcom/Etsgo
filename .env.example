# Copy to .env in repository root. Never commit .env.
DATABASE_URL=postgresql+psycopg://etsgo:etsgo-local-only@localhost:5432/etsgo
POSTGRES_PASSWORD=etsgo-local-only
ENVIRONMENT=production
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# AI: AI_PROVIDER=openai or anthropic (empty = whichever key is set). Keys stay on the backend.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
# Optional: OPENAI_BASE_URL for a compatible gateway; OPENAI_API_STYLE=chat if it lacks /responses.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_STYLE=responses
ANTHROPIC_API_KEY=
# Optional reasoning effort for reasoning models (e.g. low). Leave empty for other models.
AI_REASONING_EFFORT=
DAILY_AI_LIMIT=20
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:8000
# Optional local development only; >=32 random characters. Never enable in production.
DEV_AUTH_SECRET=
